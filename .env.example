# Galley Control Environment Configuration
# Copy to backend/.env locally, or configure in Render / Railway / Vercel dashboard for production.
# Never commit real API keys, DB passwords, or secrets to Git.

# Environment: "development" or "production"
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL connection string (Required in production; optional locally to fall back to SQLite)
# Example (Neon / Supabase / Render Postgres):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/galley_control?sslmode=require
DATABASE_URL=

# Local SQLite database file path when DATABASE_URL is empty (development only)
DATABASE_PATH=./galley_control.db

# Comma-separated frontend origins allowed by FastAPI CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_APP_URL=http://localhost:5173

# Authentication & HTTP-only cookie security
AUTH_SECRET=replace-with-strong-random-32-plus-char-secret
TOKEN_TTL_SECONDS=43200
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=300
PASSWORD_RESET_TTL_MINUTES=30

# Optional AI / LLM integration ("gemini", "openai", "groq", "openrouter", "anthropic")
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=25
CHAT_RATE_LIMIT_PER_MIN=25

# Optional SMTP email delivery for real password reset links
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@galleycontrol.example

# Development-only demo seed & reset toggle (automatically disabled when APP_ENV=production)
ENABLE_DEMO_FEATURES=true

# Optional initial production admin bootstrap (only runs when 0 admin users exist)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Campus Administrator
